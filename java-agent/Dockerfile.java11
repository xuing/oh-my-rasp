ARG TOMCAT_IMAGE=tomcat:9.0-jdk11-temurin
ARG PLAYGROUND_PROJECT=playground-java11

FROM gradle:jdk25 AS build
ARG PLAYGROUND_PROJECT
WORKDIR /workspace
COPY --chown=gradle:gradle . .
RUN gradle --no-daemon :agent-java11:agentJava11Jar ":${PLAYGROUND_PROJECT}:war"

FROM ${TOMCAT_IMAGE}
ARG PLAYGROUND_PROJECT
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /workspace/${PLAYGROUND_PROJECT}/build/libs/${PLAYGROUND_PROJECT}.war /usr/local/tomcat/webapps/ROOT.war
COPY --from=build /workspace/agent-java11/build/libs/ohmyrasp-agent-java11.jar /opt/ohmyrasp/ohmyrasp-agent-java11.jar
RUN mkdir -p /opt/ohmyrasp/logs && chmod -R 777 /opt/ohmyrasp
ENV OHMYRASP_LOG=/opt/ohmyrasp/logs/events.jsonl
ENV OHMYRASP_LOG_SYNC=true
ENV UMASK=0000
