ARG TOMCAT_IMAGE=tomcat:8.5-jdk8-temurin
ARG PLAYGROUND_PROJECT=playground-java8
ARG PLAYGROUND_WAR=playground-java8.war

FROM gradle:jdk25 AS build
ARG PLAYGROUND_PROJECT=playground-java8
WORKDIR /workspace
COPY --chown=gradle:gradle . .
RUN gradle --no-daemon :agent-java8:agentJava8Jar ":${PLAYGROUND_PROJECT}:war"

FROM ${TOMCAT_IMAGE}
ARG PLAYGROUND_PROJECT=playground-java8
ARG PLAYGROUND_WAR=playground-java8.war
RUN rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /workspace/${PLAYGROUND_PROJECT}/build/libs/${PLAYGROUND_WAR} /usr/local/tomcat/webapps/ROOT.war
COPY --from=build /workspace/agent-java8/build/libs/ohmyrasp-agent-java8.jar /opt/ohmyrasp/ohmyrasp-agent-java8.jar
RUN mkdir -p /opt/ohmyrasp/logs && chmod -R 777 /opt/ohmyrasp
ENV OHMYRASP_LOG=/opt/ohmyrasp/logs/events.jsonl
ENV UMASK=0000
