PUBLIC_BASE_URL=http://localhost

API_PORT=18090
WEB_PORT=18091
POSTGRES_PORT=15432
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
VALKEY_PORT=16379
PROMETHEUS_PORT=19090
ALERTMANAGER_PORT=19093
GRAFANA_PORT=13000

POSTGRES_USER=ohmyrasp
POSTGRES_PASSWORD=
POSTGRES_DB=ohmyrasp

CLICKHOUSE_USER=ohmyrasp
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ohmyrasp

VALKEY_PASSWORD=

GRAFANA_ADMIN_PASSWORD=

OHMYRASP_API_ADDR=0.0.0.0:8080
OHMYRASP_VERSION=dev
OHMYRASP_COMMIT=
OHMYRASP_BUILT_AT=
OHMYRASP_BOOTSTRAP_ADMIN_EMAIL=admin@ohmyrasp.local
OHMYRASP_BOOTSTRAP_ADMIN_PASSWORD=
OHMYRASP_BOOTSTRAP_ADMIN_NAME="Default Admin"
OHMYRASP_BOOTSTRAP_APP_SECRET=
OHMYRASP_ALERT_DELIVERY_ENABLED=true
OHMYRASP_ALERT_DELIVERY_INTERVAL=10s
OHMYRASP_ALERT_DELIVERY_TIMEOUT=5s
OHMYRASP_ALERT_DELIVERY_BATCH_SIZE=50

# Event-outbox drainer: replays events buffered in Postgres into ClickHouse so a
# transient ClickHouse outage does not lose them from analytics. On by default.
OHMYRASP_EVENT_OUTBOX_DRAIN_ENABLED=true
OHMYRASP_EVENT_OUTBOX_DRAIN_INTERVAL=15s
OHMYRASP_EVENT_OUTBOX_DRAIN_BATCH_SIZE=200

# /metrics protection. If OHMYRASP_METRICS_TOKEN is set, /metrics requires
# `Authorization: Bearer <token>`; if unset, /metrics is exposed unauthenticated
# (a startup warning is logged). The render is cached for the TTL below so
# repeated scrapes do not re-run full-table queries.
OHMYRASP_METRICS_TOKEN=
OHMYRASP_METRICS_CACHE_TTL=10s
